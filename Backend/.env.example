DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dailoqa
SERVICE_JWT_SECRET=

# Defaults to the Dailoqa LiteLLM gateway (Azure GPT-4o-mini); leave LLM_PROVIDER unset
# unless you're pointing at a different vendor.
LLM_PROVIDER=
LLM_KEY=
# Required when LLM_PROVIDER is litellm (or unset, since that is the default).
LLM_BASE_URL=https://dev4-broccoli-apillmgov.dailoqa.com/apillmgov
# Optional per-role overrides; provider defaults are in src/app/llm.py.
LLM_MODEL_CLASSIFIER=
LLM_MODEL_AGENT=
LLM_MODEL_TITLER=

JIRA_SITE_URL=https://rohankallummal2.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE_BUG=Bug
JIRA_ISSUE_TYPE_FEATURE=Request
JIRA_WEBHOOK_SECRET=

EVIDENCE_ROOT=/evidence

# ---- Documentation Q&A ----
# Every value here matches the default in src/app/config.py; they are listed so the corpus
# is configurable without reading the source, not because they need changing.
RAG_ENABLED=true
# The formatted corpus only. Its sibling docs-corpus/raw/ holds the upstream .mdx and the
# snippet library and must stay OUTSIDE this path -- ingestion globs recursively, so a raw/
# underneath it would index every page twice plus ~154 contextless snippet fragments.
DOCS_PATH=docs-corpus/formatted
# Which ":::<lang>" arm of the upstream docs survives ingestion. LangChain documents most
# concepts twice, in Python and JS; keeping both wastes a quarter of the corpus and lets a
# Python question come back answered in TypeScript.
DOCS_LANGUAGE=python
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval gates. Calibrated against eval/golden_set.json at 613 chunks: hit@k 1.000,
# decline 1.000. Re-run `python -m app.rag.evaluate` after any corpus change -- an absolute
# cosine gate loosens as a corpus grows, so expect to TIGHTEN this, never to relax it.
RAG_TOP_K=5
RAG_CANDIDATES=20
RRF_K=60
SEMANTIC_MAX_DISTANCE=0.35
LEXICAL_MIN_RANK=0.05

# How many of RAG_TOP_K's slots are held back so one page cannot take them all: one for an
# unseen page, one for an unseen topic. Chunks are ranked individually, so a two-subject
# question loses the smaller subject entirely -- "can a subagent use a sandbox?" returned eight
# consecutive sandboxes.md chunks. Worth 0.955 -> 1.000 hit@k at k=5 on the golden set, which
# previously needed k=8, so it also buys three chunks of context back. 0 disables.
RAG_DIVERSITY_SLOTS=2
