# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js / build output ----
.next/
out/
build/
dist/
next-env.d.ts

# ---- TypeScript ----
*.tsbuildinfo

# ---- Environment variables ----
.env
.env.*
!.env.example

# ---- Secrets / credentials (never commit) ----
client_secret*.json
*.credentials.json
*.secret.json
*-service-account*.json
*.key

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Python (Backend) ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/

# ---- Uploaded bug-report evidence (transient) ----
tmp/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.pem

# ---- Deployment ----
.vercel

# ---- AI assistant / local dev instruction files (not needed in repo) ----
# Root-anchored on purpose. Without the leading slash these match at any depth, and on a
# case-insensitive filesystem "AGENTS.md" also matches "agents.md" -- which silently excluded
# docs-corpus/formatted/langchain/agents.md from the corpus. It stayed invisible locally, since
# the file is on disk and git status is clean; only a fresh clone showed 17 of 18 pages.
/CLAUDE.md
/AGENTS.md
